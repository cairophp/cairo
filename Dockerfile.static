# One static cairo binary, linked against musl, for any x86-64 or arm64 Linux:
#   docker build -f Dockerfile.static --output dist .
# writes dist/cairo. See scripts/build-static.sh.
FROM golang:1.27-alpine3.24 AS build
RUN apk add --no-cache bash build-base autoconf bison flex re2c pkgconf cmake linux-headers curl tar xz perl patch \
      openssl-dev openssl-libs-static zlib-dev zlib-static bzip2-dev bzip2-static xz-dev xz-static \
      libxml2-dev libxml2-static sqlite-dev sqlite-static oniguruma-dev \
      libsodium-dev libsodium-static gmp-dev gmp-static libpng-dev libpng-static \
      libjpeg-turbo-dev libjpeg-turbo-static libwebp-dev libwebp-static \
      freetype-dev freetype-static brotli-dev brotli-static
WORKDIR /src
# The libraries and PHP take most of the build. They depend only on the
# script, its patches and PHP_VERSION, so this layer stays cached while Cairo's
# code changes. The default is the newest of .github/php-versions.json.
ARG PHP_VERSION=8.6.0
ENV WORK=/work
# More extensions built in (scripts/build-static.sh): PHP's own that are off
# by default and PECL packages, with APK_PACKAGES for the static libraries
# that one needs:
#   docker build -f Dockerfile.static --output dist \
#     --build-arg PECL_EXTENSIONS="apcu-5.1.28" \
#     --build-arg EXTRA_EXTENSIONS="--enable-apcu --enable-shmop" .
ARG APK_PACKAGES=""
ARG PECL_EXTENSIONS=""
ARG EXTRA_EXTENSIONS=""
RUN if [ -n "$APK_PACKAGES" ]; then apk add --no-cache $APK_PACKAGES; fi
COPY scripts/build-static.sh scripts/
COPY scripts/php-patches scripts/php-patches
RUN STAGE=php scripts/build-static.sh "$PHP_VERSION"
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG CAIRO_VERSION=dev
ARG CAIRO_TAGS=deprecated_topic,deprecated_claim
RUN --mount=type=cache,target=/root/.cache/go-build scripts/build-static.sh "$PHP_VERSION" /out/cairo

FROM scratch
COPY --from=build /out/cairo /cairo
