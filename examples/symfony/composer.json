{
    "name": "cairo/example-symfony",
    "description": "A Symfony app served by cairo serve public/index.php, through Symfony's Runtime component",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "runtime": {
            "disable_dotenv": true
        }
    }
}
